# Line endings. Not cosmetic — this file prevents a real, common, painful failure.
#
# A shell script committed with CRLF fails on a Linux CI runner with:
#     /usr/bin/env: 'bash\r': No such file or directory
# The error names the interpreter, not the line endings, so it reliably costs someone an
# afternoon. This template is authored on Windows and runs on ubuntu-latest, so every
# executable and every file a Linux tool parses is pinned to LF.

* text=auto eol=lf

# ── Must be LF: executed or parsed by Linux tooling ──────────────────────────
*.sh            text eol=lf
*.bash          text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.toml          text eol=lf
Makefile        text eol=lf
Dockerfile      text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf

# Git hooks and the agent guards — executed directly, LF is mandatory
.claude/hooks/* text eol=lf
scripts/*       text eol=lf

# ── Windows-native ───────────────────────────────────────────────────────────
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# ── Binary: never touch ──────────────────────────────────────────────────────
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# ── Generated evidence: exclude from diffs and language stats ────────────────
evidence/**  linguist-generated=true
*.sarif      linguist-generated=true -diff
*.cdx.json   linguist-generated=true -diff
